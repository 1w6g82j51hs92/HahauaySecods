local function addHover(btn)
    local originalSize = btn.Size
    local hoverSize = UDim2.new(originalSize.X.Scale + 0.02, originalSize.X.Offset, originalSize.Y.Scale + 0.03, originalSize.Y.Offset)
    local hoverInfo = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local leaveInfo = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, hoverInfo, {Size = hoverSize}):Play()
        local bg = btn.BackgroundColor3
        local brighten = Color3.new(math.min(bg.r + 0.08,1), math.min(bg.g + 0.08,1), math.min(bg.b + 0.08,1))
        TweenService:Create(btn, hoverInfo, {BackgroundColor3 = brighten}):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, leaveInfo, {Size = originalSize}):Play()
        TweenService:Create(btn, leaveInfo, {BackgroundColor3 = btn == copyBtn and Color3.fromRGB(220,60,60) or Color3.fromRGB(60,60,60)}):Play()
    end)
end


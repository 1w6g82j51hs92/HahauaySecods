local options = { 
    ["Pushups + Jungle Rock"] = {tool = "Pushups", durability = 10000000},
    ["Situps + Jungle Rock"] = {tool = "Situps", durability = 10000000},
    ["Handstands + Jungle Rock"] = {tool = "Handstands", durability = 10000000},
}

local function doToolAction(toolName)
    local char = player.Character
    if not char then return end

    local tool = char:FindFirstChild(toolName) or player.Backpack:FindFirstChild(toolName)
    if tool and char:FindFirstChildOfClass("Humanoid") then
        char.Humanoid:EquipTool(tool)
    end
    muscleEvent:FireServer("rep")

    local punch = char:FindFirstChild("Punch") or player.Backpack:FindFirstChild("Punch")
    if punch and char:FindFirstChildOfClass("Humanoid") then
        char.Humanoid:EquipTool(punch)
        if punch:FindFirstChild("attackTime") then
            punch.attackTime.Value = 0.001
        end
        muscleEvent:FireServer("punch", "leftHand")
        muscleEvent:FireServer("punch", "rightHand")
        punch:Activate()
    end
end

local function tryRockTouch(durability)
    local char = player.Character
    if not char then return end
    if player.Durability.Value < durability then return end

    for _, v in pairs(Workspace.machinesFolder:GetDescendants()) do
        if v.Name == "neededDurability" and v.Value == durability then
            local rock = v.Parent:FindFirstChild("Rock")
            if rock and char:FindFirstChild("LeftHand") and char:FindFirstChild("RightHand") then
                firetouchinterest(rock, char.RightHand, 0)
                firetouchinterest(rock, char.RightHand, 1)
                firetouchinterest(rock, char.LeftHand, 0)
                firetouchinterest(rock, char.LeftHand, 1)
            end
        end
    end
end

local function startRockFarm(toolName, durability)
    task.spawn(function()
        while getgenv().RockFarmStates[toolName] do
            task.wait(0.05)
            doToolAction(toolName)
            tryRockTouch(durability)
        end
    end)
end

for name, data in pairs(options) do
    getgenv().RockFarmStates[data.tool] = false
    sectionOpFarm:AddToggle(name, {
        Title = name,
        Default = false,
        Callback = function(state)
            getgenv().RockFarmStates[data.tool] = state
            if state then
                startRockFarm(data.tool, data.durability)
            else
                if player.Character and player.Character:FindFirstChild(data.tool) then
                    player.Character[data.tool].Parent = player.Backpack
                end
            end
        end
    })
end

player.CharacterAdded:Connect(function(char)
    task.wait(2)
    for toolName, state in pairs(getgenv().RockFarmStates) do
        if state then
            local durability = nil
            for _, data in pairs(options) do
                if data.tool == toolName then
                    durability = data.durability
                end
            end
            if durability then
                startRockFarm(toolName, durability)
            end
        end
    end
end)


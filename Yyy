local sectionTools = MainTab:AddSection("Farming Tools")

local player = game:GetService("Players").LocalPlayer
local AutoWeight, AutoPushups, AutoSitups, AutoHandstands, AutoFastPunch = false, false, false, false, false
local alive = true

local function equipTool(toolName)
    local char = player.Character
    local backpack = player.Backpack
    local tool = (char and char:FindFirstChild(toolName)) or backpack:FindFirstChild(toolName)
    if tool and char and char:FindFirstChildOfClass("Humanoid") then
        char.Humanoid:EquipTool(tool)
    end
end

task.spawn(function()
    while task.wait() do
        if not alive or not player:FindFirstChild("muscleEvent") then continue end
        if AutoWeight then equipTool("Weight"); player.muscleEvent:FireServer("rep") end
        if AutoPushups then equipTool("Pushups"); player.muscleEvent:FireServer("rep") end
        if AutoSitups then equipTool("Situps"); player.muscleEvent:FireServer("rep") end
        if AutoHandstands then equipTool("Handstands"); player.muscleEvent:FireServer("rep") end
        if AutoFastPunch then
            local char = player.Character
            local punch = (char and char:FindFirstChild("Punch")) or player.Backpack:FindFirstChild("Punch")
            if punch then
                punch.Parent = char
                if punch:FindFirstChild("attackTime") then punch.attackTime.Value = 0 end
                player.muscleEvent:FireServer("punch", "rightHand")
                player.muscleEvent:FireServer("punch", "leftHand")
                punch:Activate()
            end
        end
    end
end)


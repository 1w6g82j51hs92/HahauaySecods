local function lockPosition(cframe)
    _G.lockRunning = true
    _G.LockedCFrame = cframe
    if _G.lockConnection then _G.lockConnection:Disconnect() end

    _G.lockConnection = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if char and _G.lockRunning then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if hrp and hum then
                hrp.CFrame = _G.LockedCFrame
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
                hum.PlatformStand = true
            end
        end
    end)
end

local function unlockPosition()
    _G.lockRunning = false
    if _G.lockConnection then _G.lockConnection:Disconnect() end
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if hum then hum.PlatformStand = false end
end

local function startRockGlitch_PunchOnly(key, durability, cframe, face)
    _G[key] = true
    task.spawn(function()
        while _G[key] do
            local char = LocalPlayer.Character
            if not char then break end

            local durabilityStat = LocalPlayer:FindFirstChild("Durability")
            if durabilityStat and durabilityStat.Value >= durability then
                local faceVector = directions[face] or Vector3.new(0, 0, -1)
                local targetCFrame = CFrame.new(cframe.Position, cframe.Position + faceVector)

                if getgenv().TeleportMode == "Teleport to Rock" then
                    char:WaitForChild("HumanoidRootPart").CFrame = targetCFrame
                end

                lockPosition(targetCFrame)

                local tool = LocalPlayer.Backpack:FindFirstChild("Punch") or (char and char:FindFirstChild("Punch"))
                if tool and char:FindFirstChild("Humanoid") then
                    char.Humanoid:EquipTool(tool)
                    if tool:FindFirstChild("attackTime") then tool.attackTime.Value = 0 end
                    for _ = 1, 10 do
                        muscleEvent:FireServer("punch", "leftHand")
                        muscleEvent:FireServer("punch", "rightHand")
                        tool:Activate()
                    end
                end
            end
            task.wait(0.07)
        end
        unlockPosition()
    end)
end

local currentDurabilityReq = 0

local function EquipPunch()
    for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
        if v.Name == "Punch" and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid:EquipTool(v)
        end
    end
end

local function FirePunch()
    if LocalPlayer:FindFirstChild("muscleEvent") then
        LocalPlayer.muscleEvent:FireServer("punch", "leftHand")
        LocalPlayer.muscleEvent:FireServer("punch", "rightHand")
    end
end

local function AutoFarmNonTeleport()
    task.spawn(function()
        while getgenv().AutoFarm do
            task.wait(0.1)
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("LeftHand") or not char:FindFirstChild("RightHand") then continue end
            local durability = LocalPlayer:FindFirstChild("Durability")
            if durability and durability.Value >= currentDurabilityReq then
                for _, v in pairs(Workspace.machinesFolder:GetDescendants()) do
                    if v.Name == "neededDurability" and v.Value == currentDurabilityReq then
                        local rock = v.Parent:FindFirstChild("Rock")
                        if rock then
                            EquipPunch()
                            firetouchinterest(rock, char.RightHand, 0)
                            firetouchinterest(rock, char.RightHand, 1)
                            firetouchinterest(rock, char.LeftHand, 0)
                            firetouchinterest(rock, char.LeftHand, 1)
                            FirePunch()
                        end
                    end
                end
            end
        end
    end)
end

local function RespawnHook()
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(2)
        if getgenv().TeleportMode == "Non Teleport" and getgenv().AutoFarm then
            AutoFarmNonTeleport()
        else
            for _, rock in ipairs(_G.ActiveRocks or {}) do
                if _G[rock.key] then
                    startRockGlitch_PunchOnly(rock.key, rock.dur, CFrame.new(rock.pos), rock.face)
                end
            end
        end
    end)
end

local function StartFarmNonTeleport()
    if getgenv().AutoFarm then return end
    getgenv().AutoFarm = true
    RespawnHook()
    AutoFarmNonTeleport()
end

local function StopFarmNonTeleport()
    getgenv().AutoFarm = false
end

